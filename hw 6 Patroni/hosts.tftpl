[lb]
${haproxy.name} ansible_host=%{ if haproxy.network_interface[0].nat_ip_address != "" }${haproxy.network_interface[0].nat_ip_address}%{ endif } local_address=${haproxy.network_interface[0].ip_address} ansible_user=admind

[db]
%{ for server in nodes ~}
${server.name} ansible_host=%{ if server.network_interface[0].nat_ip_address != "" }${server.network_interface[0].nat_ip_address}%{ endif } local_address=${server.network_interface[0].ip_address} ansible_user=admind
%{ endfor ~}


